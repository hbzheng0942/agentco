DEEPSEEK_API_KEY=sk-xxx
MOONSHOT_API_KEY=sk-xxx
LITELLM_MASTER_KEY=sk-agentco-任意强随机串
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_SECRET=
# 机器人加签secret,可空
GATEWAY_TOKEN=强随机串(验收按钮鉴权,openssl rand -hex 16)
GATEWAY_BIND=127.0.0.1:9000
PUBLIC_BASE_URL=
# Cloudflare Tunnel地址,如 https://agentco.example.com;空=卡片降级纯文本
FEISHU_VERIFY_TOKEN=
# 飞书应用事件订阅Verification Token(入站信箱用,可空)
BRAVE_API_KEY=
# Brave Search API key(https://brave.com/search/api/)。search.py 的 web+news 两路;空=该两路降级失败但不阻断其余
SERPER_API_KEY=
# Serper.dev API key(https://serper.dev)。search.py 的 web+news 两路;空=该两路降级失败但不阻断其余

# 飞书云文档存档(md 产物自动传到云空间 agentco 目录;不配则出站消息退回本地路径)
# 应用后台开通 drive:drive 权限;FOLDER_TOKEN=云空间目标文件夹 URL 末段 token
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ARCHIVE_FOLDER_TOKEN=
